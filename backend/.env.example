# Substitua localmente; nunca versione .env.
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/jardim_de_papel
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# Supabase Auth: URL pública do projeto, sem barra no final.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Somente se o projeto usar assinatura legada HS256; nunca exponha no frontend.
# SUPABASE_JWT_SECRET=
# Somente no backend: necessária para o upload seguro ao Storage.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=editorial-media
MEDIA_SIGNED_URL_SECONDS=900
